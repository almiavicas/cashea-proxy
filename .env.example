# Copia este archivo a .env y completa los valores reales. .env nunca se sube al repo.

# Subdominio propio que apunta a la IP elastica de esta instancia (registro A en el DNS).
DOMAIN=cashea-proxy.mdticket.com

# Host real de la API de Cashea al que se reenvian las solicitudes.
# Produccion: external.cashea.app
# Sandbox/staging de Cashea: external.staging.cashea.app
UPSTREAM_HOST=external.cashea.app

# Secreto compartido que Django debe enviar en el header X-Proxy-Secret.
# Sin este header (o con uno incorrecto) el proxy responde 403 - evita que quede
# como relay abierto hacia la API de Cashea. Generar con: openssl rand -hex 32
PROXY_SECRET=changeme-generar-un-valor-largo-y-aleatorio

# Correo usado por Let's Encrypt para notificaciones de expiracion de certificado.
EMAIL=ops@mdticket.com
